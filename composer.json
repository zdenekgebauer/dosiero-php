{
  "name": "zdenekgebauer/dosiero",
  "description": "PHP server connector for Dosiero file manager",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Zdenek Gebauer",
      "email": "zdenek.gebauer@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Dosiero\\": "src/"
    }
  },
  "require-dev": {
    "codeception/codeception": "^5.3",
    "codeception/module-asserts": "^3.3",
    "codeception/module-rest": "^3.4",
    "codeception/module-phpbrowser": "^3.0",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "rector/rector": "^2.6",
    "symplify/easy-coding-standard": "^13.2"
  }
}
