{
  "name": "zdenekgebauer/dosiero",
  "description": "PHP server connector for Dosiero file manager",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Zdenek Gebauer",
      "email": "zdenek.gebauer@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-json": "*"
  },
  "suggest": {
    "ext-ftp": "required by Dosiero\\Ftp\\FtpStorage"
  },
  "autoload": {
    "psr-4": {
      "Dosiero\\": "src/"
    }
  },
  "require-dev": {
    "codeception/codeception": "^5.3",
    "codeception/module-asserts": "^3.3",
    "codeception/module-phpbrowser": "^4.1",
    "codeception/module-rest": "^3.4",
    "infection/codeception-adapter": "^0.4",
    "infection/infection": "^0.35",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "rector/rector": "^2.8",
    "shipmonk/composer-dependency-analyser": "^1.8",
    "symplify/easy-coding-standard": "^13.3"
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
